# DB
POSTGRES_USER=face_vault
POSTGRES_PASSWORD=change_me
POSTGRES_DB=face_vault

# AI プロバイダ: openai | anthropic | gemini
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# 顔照合閾値（コサイン類似度の最小一致）
MATCH_THRESHOLD=0.35

# フロント: ブラウザから見たbackend URL
NEXT_PUBLIC_API_BASE=http://localhost:8017

# Dockerビルド: 顔認識ランタイム(InsightFace/FAISS)を入れる場合 true
INSTALL_FACE=true

# Cloudflare Tunnel（任意）: ダッシュボードで発行したトークン。
# 起動: docker compose --profile tunnel up -d
CLOUDFLARE_TUNNEL_TOKEN=
